NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
AUTH_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
# Optional. Required only for POST /api/ai/ask. Store the real key in server/.env, never in VITE_* variables.
GROQ_API_KEY=
# Comma-separated exact browser origins. Local Vite origins are allowed automatically outside production.
CORS_ORIGINS=
